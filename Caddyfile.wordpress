{
	on_demand_tls {
        ask {$PRIVATE_BACKEND_URL:localhost:8000}/api/builder/domains/ask-public-domain-exists/
    }

    {$BASEROW_CADDY_GLOBAL_CONF}
}

{$BASEROW_CADDY_ADDRESSES} {
    tls {
        on_demand
    }

    @is_baserow_tool {
        expression `
            "{$BASEROW_PUBLIC_URL}".contains({http.request.host}) ||
            "{$BASEROW_EXTRA_PUBLIC_URLS}".split(",")
                .filter(u, u != "" && u.contains({http.request.host}))
                .size() > 0
        `
    }

    handle @is_baserow_tool {
        # ── WordPress: exact root ────────────────────────────────
        @wp_home path /
        handle @wp_home {
            reverse_proxy wordpress:80
        }

        # ── WordPress: admin, assets, REST API ───────────────────
        @wp_paths path /wp-admin/* /wp-content/* /wp-includes/* /wp-json/* /wp-login.php /wp-cron.php
        handle @wp_paths {
            reverse_proxy wordpress:80
        }

        # ── WordPress: explicit page slugs (otherwise Nuxt handles the path) ──
        @wp_page_slugs path /shop-terms /shop-terms/ /shop-terms/* /terms /terms/ /terms/* /privacy-policy /privacy-policy/ /privacy-policy/* /refund /refund/ /refund/* /about /about/ /about/*
        handle @wp_page_slugs {
            reverse_proxy wordpress:80
        }

        # ── Block xmlrpc ─────────────────────────────────────────
        @xmlrpc path /xmlrpc.php
        handle @xmlrpc {
            respond "Forbidden" 403
        }

        # ── Baserow backend routes ───────────────────────────────
        @backend_routes path /api/* /ws/* /mcp/* /assistant/* {$BASEROW_CADDY_BACKEND_EXTRA_ROUTES:}
        handle @backend_routes {
            reverse_proxy {$PRIVATE_BACKEND_URL:localhost:8000}
        }

        handle_path /media/* {
            @downloads {
                query dl=*
            }
            header @downloads Content-disposition "attachment; filename={query.dl}"

            header {
                Access-Control-Allow-Origin {$BASEROW_PUBLIC_URL:http://localhost}
                Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                Access-Control-Allow-Headers "*"
                Access-Control-Expose-Headers "Content-Length, Content-Type"
            }

            file_server {
                root {$MEDIA_ROOT:/baserow/media/}
            }
        }

        handle_path /static/* {
            file_server {
                root {$STATIC_ROOT:/baserow/static/}
            }
        }
    }

    reverse_proxy {$PRIVATE_WEB_FRONTEND_URL:localhost:3000}
}
